# Node / TypeScript build artifacts
node_modules/
dist/
# Anchored: an unanchored `build/` matches at every depth, and the only such
# directory in this tree is `tests/unit/build/` — the release-gate suite. It
# silently swallowed every new file added there, so `release-qualification.test.ts`
# ran locally for several features while never existing in the repository.
/build/
out/
coverage/
*.tsbuildinfo

# Logs
*.log

# Secrets
.env*

# VS Code extension build & test artifacts
*.vsix
.vscode-test/
tests/soak/.artifacts/
tests/visual/.artifacts/

# OS / editor noise
.DS_Store
Thumbs.db
*~
.#*
*.swp
*.swo

# Runtime sidecar — per-run, intentionally unredacted developer-debug
# artefacts under .schegent/sessions/raw-<runId>.log. Local only —
# never committed. See docs/features/round_1/008-raw-transcript-logging.md FR-009.
.schegent/

# Local scratch
scratch/
empty/
# Per-run test temp root created by tests/global-temp-root.ts. Anchored for the
# same reason `/build/` above is: an unanchored pattern matches at every depth.
/.tmp/

# FR-R3-095 — the local gate attestation. Untracked deliberately: it records one
# machine's observation of one tree at one moment, so committing it would publish
# a claim about a checkout nobody else has, and the next clone would inherit an
# attestation it never earned.
/.gate-attestation.json
