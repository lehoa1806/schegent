// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ModelCatalogEditor stays out of the lifecycle (US1, T038, FR-041) > holds its rendered markup as the baseline the rest of the feature must not move 1`] = `"<div class="models-container"><div class="toolbar" style="margin-bottom: 24px;"><div style="flex: 1;"></div> <button type="button" class="btn btn-secondary">Export Model Catalog</button> <button type="button" class="btn btn-primary">Save All Models</button></div> <!----> <!----> <div class="backend-section" style="margin-bottom: 32px; padding: 16px; background: var(--sch-glass-bg); border: 1px solid var(--sch-glass-border); border-radius: var(--schegent-radius);"><h3 style="margin-bottom: 16px; text-transform: capitalize;">claude Models</h3> <div class="toolbar" style="margin-bottom: 16px;"><form class="model-form"><input class="text-input flex-1" aria-label="New claude model name" placeholder="e.g. claude-3-7-sonnet-20250219"> <button class="btn btn-secondary" type="submit">Add Model</button></form> <button type="button" class="btn btn-secondary" style="margin-left: 12px;" aria-label="Detect claude models" title="Add the 1 model(s) claude reported, skipping any already listed.">Detect</button></div> <div class="models-list"><!----> <div class="model-list-item"><input class="text-input flex-1" aria-label="claude model 1"> <button type="button" class="btn btn-destructive" style="margin-left: 12px;" aria-label="Remove claude model claude-sonnet">Remove</button></div><!----></div></div><!----></div>"`;
