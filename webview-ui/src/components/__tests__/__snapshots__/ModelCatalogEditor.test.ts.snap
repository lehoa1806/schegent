exports[`ModelCatalogEditor stays out of the lifecycle (US1, T038, FR-041) > holds its rendered markup as the baseline the rest of the feature must not move 1`] = `"<div class="model-catalog"><div class="toolbar"><span class="small muted">Models a Phase can choose. Detected models come from each installed backend.</span> <div class="push"><button type="button" class="btn btn-secondary" aria-label="Export Model Catalog">Export…</button> <button type="button" class="btn btn-primary">Save</button></div></div> <!----> <section class="section" aria-labelledby="model-catalog-backend-0"><div class="mhead svelte-jc318f"><h2 class="svelte-jc318f" id="model-catalog-backend-0">claude</h2> <span class="small muted">1 model</span> <span class="push mhead-actions svelte-jc318f"><button type="button" class="btn btn-ghost btn-sm" aria-label="Detect claude models" title="Add the 1 model(s) claude reported, skipping any already listed."><svg class="i" aria-hidden="true"><use href="#i-refresh"></use></svg>Detect</button> <button type="button" class="btn btn-ghost btn-sm" id="model-catalog-add-toggle-0" aria-expanded="false"><svg class="i" aria-hidden="true"><use href="#i-plus"></use></svg>Add model</button></span></div> <!----> <div class="table-wrap"><table class="t fit model-table svelte-jc318f"><thead><tr><th scope="col">Model</th><th scope="col" class="col-source svelte-jc318f">Source</th><th scope="col" class="col-remove svelte-jc318f"><span class="sr-only">Remove</span></th></tr></thead><tbody><tr class="model-list-item"><td class="cell-control svelte-jc318f"><input class="input mono model-id svelte-jc318f" aria-label="claude model 1"></td><td>Detected</td><td class="cell-control cell-remove svelte-jc318f"><button type="button" class="icon-btn svelte-jc318f" aria-label="Remove claude model claude-sonnet"><svg class="i" aria-hidden="true"><use href="#i-x"></use></svg></button></td></tr></tbody></table></div><!----></section><!----></div>"`;
