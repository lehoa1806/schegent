{
  "name": "@schegent/webview-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test:mocks:check": "node tests/tooling/update-queue-projection-mocks.mjs --check",
    "test": "npm run test:mocks:check && vitest run",
    "test:coverage": "npm run test:mocks:check && vitest run --coverage && node ../scripts/check-coverage-headroom.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^25.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.4.0",
    "vite": "^7.3.5",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
