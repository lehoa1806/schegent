{
  // FR-R3-073 (feature 152) — the interactive Extension Development Host the
  // user quickstart's F5 instruction assumes. `tests/lint/launch-procedure-
  // doc-parity.test.ts` holds the tutorials and this file to one procedure.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      // FR-R3-101 (FR-028) — `dist`, not `out`.
      //
      // This said `out/**/*.js`, which is the INTEGRATION-TEST compile target
      // (`tsconfig.integration.json`). The extension host bundles to
      // `dist/extension.js` (`esbuild.config.mjs`), so F5 breakpoints bound against the
      // wrong artifact — set anywhere in `src/`, they simply never hit, and nothing said
      // why. `tests/lint/launch-config-outfiles.test.ts` now reads this file and the
      // bundler config and fails when they name different directories.
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      // Review gap GC-23 (2026-11-12) — debug the host test file open in the editor, with the
      // root vitest config `test:host` uses. Host tests only: `webview-ui/` has its own config.
      "name": "Debug Current Host Test File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal"
    }
  ]
}
